#!/bin/bash

# ==========================================
# T4n IDE (Python + Zig) Installer for NvChad
# Zig via Let-X (VUR Helper), fallback curl
# LSP & Treesitter via NvChad default command
# ==========================================

set -e  # Exit on error

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# --- Helper Functions ---
log_info() { echo -e "${BLUE}[+] $1${NC}"; }
log_success() { echo -e "${GREEN}[✔] $1${NC}"; }
log_warn() { echo -e "${YELLOW}[!] $1${NC}"; }
log_error() { echo -e "${RED}[✗] $1${NC}"; exit 1; }

# Get Script Directory
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Check Root
if [ "$EUID" -eq 0 ]; then 
  log_error "Do not run this script as root. Use a regular user (sudo will be prompted if necessary)."
fi

# ==========================================
# 1. SYSTEM DEPENDENCIES
# ==========================================
log_info "T4n IDE (Python + Zig) Installer x86_64"

if ! command -v xbps-install &> /dev/null; then
  log_error "XBPS not found. This script is only for Void Linux / T4n OS."
fi

log_info "Updating system packages..."
sudo xbps-install -Syu

log_info "Installing base packages..."
sudo xbps-install -y \
  git curl wget unzip \
  neovim python3 \
  python3-pip python3-virtualenv python3-devel \
  ripgrep fd tree-sitter tree-sitter-cli

# ==========================================
# 2. PYTHON SETUP
# ==========================================
log_info "Setting up Python environment..."

# Upgrade pip dan install tools python
python3 -m ensurepip --upgrade || true
pip3 install --user --upgrade pip
pip3 install --user pynvim ruff

log_info "Install UV - Package Manager..."
if ! command -v uv &> /dev/null; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# ==========================================
# 3. ZIG SETUP
# ==========================================
ZIG_VERSION="0.16.0"
ZIG_INSTALL_DIR="/opt/zig-${ZIG_VERSION}"
ZIG_BIN_LINK="/usr/local/bin/zig"

# Opsi 1: Install via Let-X (VUR Helper T4n Labs)
install_zig_via_letx() {
  if ! command -v letx &> /dev/null; then
    return 1
  fi

  log_info "Let-X detected, installing Zig via VUR Helper..."
  letx get zig && \
  letx -x pkg zig && \
  letx set zig
}

# Opsi 2: Fallback - download manual via curl, symlink ke PATH standar
install_zig_via_curl() {
  log_info "Installing Zig ${ZIG_VERSION} via curl to ${ZIG_INSTALL_DIR}..."

  local tarball="zig-linux-x86_64-${ZIG_VERSION}.tar.xz"
  cd /tmp

  # Download jika belum ada
  if [ ! -f "$tarball" ]; then
    curl -LsSf -o "$tarball" "https://ziglang.org/download/${ZIG_VERSION}/${tarball}"
  fi

  # Hapus instalasi lama jika ada, ekstrak ke /opt
  sudo rm -rf "$ZIG_INSTALL_DIR"
  sudo mkdir -p "$ZIG_INSTALL_DIR"
  tar -xf "$tarball"
  sudo cp -r "zig-linux-x86_64-${ZIG_VERSION}"/* "$ZIG_INSTALL_DIR/"

  # Symlink ke /usr/local/bin (sudah ada di PATH default, gak perlu edit .bashrc)
  sudo ln -sf "$ZIG_INSTALL_DIR/zig" "$ZIG_BIN_LINK"
}

log_info "Setting up Zig..."
if ! install_zig_via_letx; then
  log_warn "Let-X tidak tersedia/gagal, fallback ke instalasi manual via curl."
  install_zig_via_curl
fi

# Verifikasi
if ! command -v zig &> /dev/null; then
  log_error "Zig is not installed properly, check the installation steps above."
fi
log_success "Zig $(zig version) is ready to use in $(command -v zig)"

# ==========================================
# 4. FONT INSTALLATION
# ==========================================
log_info "Installing FiraCode Nerd Font..."

FONT_DIR="$HOME/.fonts"
mkdir -p "$FONT_DIR"
cd "$FONT_DIR"

# Cek jika file zip sudah ada untuk hindari download ulang
if [ ! -f "FiraCode.zip" ]; then
  wget -q https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip
fi

unzip -o -q FiraCode.zip
rm -f FiraCode.zip
fc-cache -fv > /dev/null

# ==========================================
# 5. NVCHAD CONFIGURATION
# ==========================================
log_info "Setting up NvChad configuration..."

# Cek apakah folder nvim ada di script directory
if [ ! -d "$PROJECT_DIR/nvim" ]; then
  log_error "The folder 'nvim' was not found in '$PROJECT_DIR'. Make sure the file structure is correct."
fi

# Backup old config
TIMESTAMP=$(date +%s)
BACKUP_DIR="$HOME/.config/nvim.bak.$TIMESTAMP"
mv ~/.config/nvim "$BACKUP_DIR" 2>/dev/null || true
mv ~/.local/share/nvim "$BACKUP_DIR-data" 2>/dev/null || true

# Copy config baru
rm -rf ~/.config/nvim
cp -r "$PROJECT_DIR/nvim" ~/.config/nvim

# ==========================================
# 6. NEOVIM SYNC & PLUGINS
# ==========================================
log_info "Syncing Neovim plugins..."
nvim --headless "+Lazy sync" +qa

# ========================
# INSTALL LSP VIA MASON
# ========================
log_info "Installing LSP (ty & zls) via Mason..."
nvim --headless "+MasonInstall ty zls" +qa || true

log_info "Installing Treesitter parsers (Python, Zig)..."
nvim --headless "+TSInstall python zig" +qa || true

# ==========================================
# FINISH
# ==========================================
echo ""
log_success "Installation Complete!"
echo ""
log_warn "Struktur Installasi:"
echo "    Zig  : $(command -v zig)"
echo ""
log_warn "UV mungkin butuh reload shell biar masuk PATH:"
echo "    source ~/.bashrc   (jika pakai bash)"
echo "    source ~/.zshrc   (jika pakai zsh)"
echo ""
log_info "Kemudian buka nvim. Plugin akan otomatis selesai download."
